# Postgres
DATABASE_URL=postgres://kaja:kaja_dev@localhost:5433/kaja

# Session cookie signing - generate with: openssl rand -base64 32
SESSION_SECRET=

# Gemini API key (free tier, BYOK). Users can also set their own key in
# Settings; this is the server-level fallback.
GEMINI_TOKEN=

# Optional - Gemini model to use (gemini-2.5-flash is deprecated for new keys)
GEMINI_MODEL=gemini-3-flash-preview

# Optional - stronger Gemini model for the "Analyze again" escalation
# GEMINI_MODEL_BETTER=gemini-3.6-flash

# Optional - OpenRouter fallback: used automatically when Gemini is
# unavailable (quota exceeded, outage). Defaults to the same Gemini model
# via OpenRouter. deepseek/deepseek-v4-flash-vision-exp also works
# (vision + JSON, but slower).
# OPENROUTER_TOKEN=sk-or-v1-...
# OPENROUTER_MODEL=google/gemini-3-flash-preview

# Public origin
APP_URL=http://localhost:3100

# Optional - seed users as JSON instead of users.config.json:
# USERS_JSON=[{"username":"dad","password":"..."}]
